--- /dev/null
+++ b/steel-core/src/chunk/chunk_map/region_generation.rs
@@ -0,0 +1,146 @@
+//! Stage-batched generation for an exclusively owned, disposable region.
+use super::ChunkMap;
+use crate::chunk::{
+    chunk_generation_task::StaticCache2D,
+    chunk_holder::ChunkHolder,
+    chunk_pyramid::{ChunkStep, GENERATION_PYRAMID},
+    chunk_ticket_manager::ticket_level_for_status,
+    status::ChunkStatus,
+};
+use rayon::prelude::*;
+use std::{
+    collections::BTreeMap,
+    sync::{Arc, atomic::Ordering},
+};
+use steel_utils::ChunkPos;
+
+impl ChunkMap {
+    /// Generates a closed region through Full without one dependency walk per requested chunk.
+    ///
+    /// The world must be empty, exclusively owned, and have its refill loop stopped.
+    /// All halo sizes come from the upstream generation pyramid. Stages that only write
+    /// their center run in parallel; Features and Light use fixed disjoint phases.
+    ///
+    /// # Errors
+    /// Returns an error for invalid bounds, an active/nonempty world, or missing dependencies.
+    pub fn generate_region_in_order(
+        self: &Arc<Self>,
+        min: ChunkPos,
+        max: ChunkPos,
+        pool: &rayon::ThreadPool,
+    ) -> Result<Vec<Arc<ChunkHolder>>, String> {
+        let _phase = self.source_phase_guard.lock();
+        if !self.generation_refill_stopped.load(Ordering::Acquire) || !self.chunks.is_empty() {
+            return Err("region generation requires an empty, stopped world".to_owned());
+        }
+        if min.0.x > max.0.x || min.0.y > max.0.y {
+            return Err("invalid region bounds".to_owned());
+        }
+        let full = GENERATION_PYRAMID.get_step_to(ChunkStatus::Full);
+        let radius = full.get_accumulated_radius_of(ChunkStatus::Empty) as i32;
+        for (low, high) in [(min.0.x, max.0.x), (min.0.y, max.0.y)] {
+            if low.checked_sub(radius).is_none() || high.checked_add(radius).is_none() {
+                return Err("region halo exceeds coordinate range".to_owned());
+            }
+        }
+        for pos in region_positions(min, max, radius) {
+            let dx = (i64::from(min.0.x) - i64::from(pos.0.x))
+                .max(i64::from(pos.0.x) - i64::from(max.0.x))
+                .max(0);
+            let dz = (i64::from(min.0.y) - i64::from(pos.0.y))
+                .max(i64::from(pos.0.y) - i64::from(max.0.y))
+                .max(0);
+            let distance = dx.max(dz) as usize;
+            let needed = if distance == 0 {
+                Some(ChunkStatus::Full)
+            } else {
+                full.accumulated_dependencies.get(distance)
+            };
+            let needed = needed.ok_or("region halo has no generation requirement")?;
+            let holder = Arc::new(ChunkHolder::new_with_full_publications(
+                pos,
+                ticket_level_for_status(needed),
+                None,
+                self.world_gen_context.min_y(),
+                self.world_gen_context.height(),
+                Arc::downgrade(&self.full_publications),
+            ));
+            if self.chunks.insert_sync(pos, holder).is_err() {
+                return Err("region holder already exists".to_owned());
+            }
+        }
+        let mut status = Some(ChunkStatus::Empty);
+        while let Some(current) = status {
+            let step = GENERATION_PYRAMID.get_step_to(current);
+            let radius = full.get_accumulated_radius_of(current) as i32;
+            let positions = region_positions(min, max, radius);
+            if matches!(current, ChunkStatus::Features | ChunkStatus::Light) {
+                let period = step.direct_dependencies.get_radius() as i32 * 2 + 1;
+                let mut rounds = BTreeMap::<(i32, i32), Vec<ChunkPos>>::new();
+                for pos in positions {
+                    rounds
+                        .entry((pos.0.x.rem_euclid(period), pos.0.y.rem_euclid(period)))
+                        .or_default()
+                        .push(pos);
+                }
+                for positions in rounds.values() {
+                    self.run_region_stage(step, positions, pool);
+                }
+            } else {
+                self.run_region_stage(step, &positions, pool);
+            }
+            status = current.next();
+        }
+        region_positions(min, max, 0)
+            .into_iter()
+            .map(|pos| {
+                self.chunks
+                    .read_sync(&pos, |_, holder| Arc::clone(holder))
+                    .ok_or_else(|| format!("generated holder disappeared at {pos:?}"))
+            })
+            .collect()
+    }
+
+    /// Runs one stage after its complete input halo has reached the parent stages.
+    fn run_region_stage(
+        self: &Arc<Self>,
+        step: &'static ChunkStep,
+        positions: &[ChunkPos],
+        pool: &rayon::ThreadPool,
+    ) {
+        pool.install(|| {
+            positions.par_iter().for_each(|pos| {
+                let owner = Arc::clone(self);
+                let cache = Arc::new(StaticCache2D::create(
+                    pos.0.x,
+                    pos.0.y,
+                    step.direct_dependencies.get_radius() as i32,
+                    move |x, z| {
+                        let Some(holder) = owner
+                            .chunks
+                            .read_sync(&ChunkPos::new(x, z), |_, holder| Arc::clone(holder))
+                        else {
+                            panic!("region dependency disappeared at ({x},{z})");
+                        };
+                        holder
+                    },
+                ));
+                let holder = Arc::clone(cache.get(pos.0.x, pos.0.y));
+                (step.task)(
+                    Arc::clone(&self.world_gen_context),
+                    step,
+                    &cache,
+                    Arc::clone(&holder),
+                );
+                holder.finish_generation_status(step.target_status);
+            })
+        });
+    }
+}
+
+/// Enumerates a rectangular core and its halo in stable X/Z order.
+fn region_positions(min: ChunkPos, max: ChunkPos, radius: i32) -> Vec<ChunkPos> {
+    (min.0.x - radius..=max.0.x + radius)
+        .flat_map(|x| (min.0.y - radius..=max.0.y + radius).map(move |z| ChunkPos::new(x, z)))
+        .collect()
+}
